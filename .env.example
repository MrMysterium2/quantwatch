# Kopieren nach .env und mit echten Werten befuellen:
#   cp .env.example .env

# --- PostgreSQL ---
POSTGRES_USER=aktien
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=aktien_tool

# --- Finnhub (kostenlos: https://finnhub.io) ---
# Free-Tier deckt nur US-Ticker ab (Earnings-Kalender + rohe Company-News).
# Ohne Key laeuft das Tool trotzdem - Finnhub-Features liefern dann nur leere Ergebnisse.
FINNHUB_API_KEY=your_finnhub_api_key_here

# --- Discord Webhook (optional, fuer Watchlist-Alerts) ---
# Discord -> Servereinstellungen -> Integrationen -> Webhooks -> Neuer Webhook
# Ohne URL werden Alerts nur geloggt, nicht versendet.
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# --- JWT Signing Secret ---
# Erzeugen mit: openssl rand -hex 32
# Pflichtfeld - das Backend startet ohne gesetzten Wert nicht (siehe auth.py).
JWT_SECRET=generate_with_openssl_rand_hex_32
